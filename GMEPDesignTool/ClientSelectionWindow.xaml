<Window x:Class="GMEPDesignTool.ClientSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GMEPDesignTool"
        mc:Ignorable="d"
        Title="ClientSelectionWindow" Height="229" Width="502">

    <Grid Margin="0,0,10,-6">
        <Label Content="Search" HorizontalAlignment="Left" Margin="10,30,0,0" VerticalAlignment="Top"/>
        <TextBox Name="SearchTextBox" HorizontalAlignment="Left" Margin="73,35,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <Label Content="Results" HorizontalAlignment="Left" Margin="10,53,0,0" VerticalAlignment="Top"/>
        <DataGrid Name="ClientsDataGrid" ItemsSource="{Binding Clients}" Margin="10,84,10,25" SelectedItem="{Binding Path=SelectedClient,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" AutoGenerateColumns="False">
            <DataGrid.ContextMenu>
                <ContextMenu Name="ClientSelectionContextMenu">
                    <MenuItem Header="Select" Click="Select_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Company Name" Binding="{Binding Name}">
                </DataGridTextColumn>
                <DataGridTextColumn Header="NetSuite ID" Binding="{Binding Id}">
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Label Foreground="Red"  Content="Remove" HorizontalAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Top" Visibility="{Binding Path=RemoveLabelVisibility}" MouseDoubleClick="RemoveLabel_DoubleClick" Cursor="Hand"/>
        <Label Foreground="Red"  Content="NetSuite auth required" HorizontalAlignment="Left" Margin="216,31,0,0" VerticalAlignment="Top" Visibility="{Binding Path=NetSuiteAuthWarningVisibility}"/>
        <Label Content="Current" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Label Content="{Binding CurrentCompanyName}" HorizontalAlignment="Left" Margin="73,10,0,0" VerticalAlignment="Top" Cursor="Hand" MouseDoubleClick="CurrentCompanyName_DoubleClick" Foreground="Blue"/>
    </Grid>
</Window>
