<Window x:Class="GMEPDesignTool.ClientSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GMEPDesignTool"
        mc:Ignorable="d"
        Title="ClientSelectionWindow" Height="450" Width="800">
    
    <Grid>
        <Label Content="Search" HorizontalAlignment="Left" Margin="10,37,0,0" VerticalAlignment="Top"/>
        <TextBox Name="SearchTextBox" HorizontalAlignment="Left" Margin="73,41,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <Label Content="Results" HorizontalAlignment="Left" Margin="10,68,0,0" VerticalAlignment="Top"/>
        <DataGrid Name="ClientsDataGrid" ItemsSource="{Binding Clients}" Margin="10,99,239,174" SelectedItem="{Binding Path=SelectedClient,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" AutoGenerateColumns="False">
            <DataGrid.ContextMenu>
                <ContextMenu Name="ClientSelectionContextMenu">
                    <MenuItem Header="Select" Click="Select_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Company Name" Binding="{Binding Name}">                    
                </DataGridTextColumn>
                <DataGridTextColumn Header="NetSuite ID" Binding="{Binding Id}">                    
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
