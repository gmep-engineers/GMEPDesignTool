<Window x:Class="GMEPDesignTool.AddEditContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GMEPDesignTool"
        mc:Ignorable="d"
        Title="Add/Edit Client" Height="800" Width="800">
    <Window.Resources>
        <local:StringLengthToBoolConverter x:Key="StringLengthToBoolConverter"/>
        <CollectionViewSource x:Key="ContactsViewSource" Source="{Binding CompanyContacts}" />
    </Window.Resources>
    <Grid>
        <Menu>
            <MenuItem Header="_File">
                <MenuItem Header="_Save" Click="SaveClick"/>
            </MenuItem>
        </Menu>
        <ScrollViewer VerticalScrollBarVisibility="Auto"  Margin="0 25 0 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Label FontFamily="Tahoma" FontSize="26" Content="{Binding Path=CompanyName}" />
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid KeyUp="ContactDataGrid_KeyUp" Name="ContactsDataGrid" ItemsSource="{Binding Source={StaticResource ContactsViewSource}}" SelectedItem="{Binding Path=SelectedContact,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" AutoGenerateColumns="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="CadetBlue"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Path=Delete}" Value="True">
                                        <Setter Property="Background" Value="Pink"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu Name="ContactContextMenu">
                                <MenuItem Header="Flag for deletion" Click="FlagContactForDeletion_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Email Address" Binding="{Binding EmailAddress, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Phone Number">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="PhoneNumber" UpdateSourceTrigger="LostFocus" StringFormat="{}{0:(###) ###-####}" TargetNullValue="{}">
                                        <Binding.Converter>
                                            <local:PhoneNumberConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Extension" Binding="{Binding Extension, UpdateSourceTrigger=LostFocus, TargetNullValue={}}"/>
                            <DataGridTemplateColumn Header="Set Primary">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Set Primary"  Click="SetPrimary_Click" CommandParameter="{Binding Path=Id}">                                            
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>                          
            </Grid>            
        </ScrollViewer>
    </Grid>
</Window>
