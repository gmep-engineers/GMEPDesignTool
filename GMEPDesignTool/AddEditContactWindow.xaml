<Window x:Class="GMEPDesignTool.AddEditContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GMEPDesignTool"
        mc:Ignorable="d"
        Title="Add/Edit Client" Height="800" Width="800">
    <Window.Resources>
        <local:StringLengthToBoolConverter x:Key="StringLengthToBoolConverter"/>
        <CollectionViewSource x:Key="ContactsViewSource" Source="{Binding CompanyContacts}" />
    </Window.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <DataGrid Name="ContactsDataGrid" ItemsSource="{Binding Source={StaticResource ContactsViewSource}}" SelectedItem="{Binding Path=SelectedContact,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Company" Binding="{Binding CompanyName, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Email Address" Binding="{Binding EmailAddress, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Phone Number">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="PhoneNumber" UpdateSourceTrigger="LostFocus" StringFormat="{}{0:(###) ###-####}" TargetNullValue="{}">
                                        <Binding.Converter>
                                            <local:PhoneNumberConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Extension" Binding="{Binding Extension, UpdateSourceTrigger=LostFocus, TargetNullValue={}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid Grid.Row="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Button Content="Set Primary" Grid.Column="1" Grid.Row="1" Margin="10,0,0,10" Visibility="Hidden"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="175"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Label FontFamily="Tahoma" FontSize="16" Grid.Row="0" Content="Add New Contact"  Margin="10,5,0,5" Width="auto" />
                    <Label Grid.Row="1" Grid.Column="0" Content="First Name" VerticalAlignment="Center" Margin="10,5,0,5"/>
                    <TextBox x:Name="NewFirstNameBox" Grid.Row="1" Margin="0,0,0,10"  Grid.Column="1" Text="{Binding NewFirstName}"/>
                    <Label Grid.Row="2" Grid.Column="0" Content="Last Name" VerticalAlignment="Center" Margin="10,5,0,5"/>
                    <TextBox x:Name="NewLastNameBox" Grid.Row="2" Margin="0,0,0,10"  Grid.Column="1" Text="{Binding NewLastName}"/>
                    <Label Grid.Row="3" Grid.Column="0" Content="Email Address" VerticalAlignment="Center" Margin="10,5,0,5"/>
                    <TextBox x:Name="NewEmailAddressBox" Grid.Row="3" Margin="0,0,0,10"  Grid.Column="1" Text="{Binding NewEmailAddress}"/>
                    <Label Grid.Row="4" Grid.Column="0" Content="Phone" VerticalAlignment="Center" Margin="10,5,0,5"/>
                    <Grid Grid.Row="4" Grid.ColumnSpan="1" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="NewPhoneNumberBox" Margin="0,0,0,10" Text="{Binding NewPhoneNumber}"/>
                        <Label  Grid.Column="1" Content="Extension" VerticalAlignment="Top" Margin="10,5,0,5"/>
                        <TextBox  Grid.Column="2" x:Name="NewExtensionBox" Margin="0,0,0,10" Text="{Binding NewExtension}" Grid.ColumnSpan="2"/>
                    </Grid>
                    <Button Content="Add" Grid.Column="0" Grid.Row="5" Margin="10,0,10,10" Visibility="Visible" Click="AddPrimaryContact_Click"/>
                </Grid>
            </Grid>            
        </ScrollViewer>
    </Grid>
</Window>
